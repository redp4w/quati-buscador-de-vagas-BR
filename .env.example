# Alternativa técnica à configuração da tela Perfil > Inteligência artificial.
# Opções: none, ollama, gemini, openai_compatible. O padrão é none.
QUATI_AI_PROVIDER=none

# Caminho opcional do banco local.
# QUATI_DB=data/quati.sqlite3

# Catálogo opcional de portais e páginas públicas de empresas.
# QUATI_SOURCES_FILE=config/job_sources.yml
# Endpoints públicos também podem ser substituídos individualmente.
# QUATI_SOURCE_LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/
# QUATI_COMPANY_SHAREPEOPLEHUB_URL=https://sharepeoplehub.inhire.app/vagas

# Ollama aceita apenas endereço local.
QUATI_OLLAMA_BASE_URL=http://127.0.0.1:11434
QUATI_OLLAMA_MODEL=llama3.2

# Configure somente se autorizar enviar texto ao Gemini.
# QUATI_GEMINI_API_KEY=
# QUATI_GEMINI_MODEL=gemini-3.5-flash-lite

# APIs compatíveis com POST /chat/completions. HTTP somente em localhost.
# QUATI_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# QUATI_OPENAI_COMPATIBLE_MODEL=local-model
# QUATI_OPENAI_COMPATIBLE_API_KEY=
# Opcionais: habilitam a coleta pela API oficial da Adzuna.
# Também podem ser informadas e cifradas pela tela Buscar vagas.
QUATI_ADZUNA_APP_ID=
QUATI_ADZUNA_APP_KEY=
